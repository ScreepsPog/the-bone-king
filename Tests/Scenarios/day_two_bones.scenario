# render 1280x720
cmd Wiz.Map Practice
expect Wiz: map is Practice
cmd Wiz.Waves 0
expect Wiz: waves are off
cmd Wiz.God 1
expect Wiz: god mode is on
cmd Wiz.AddBones 1
expect Wiz: dropped 1 bones
wait 0.5
cmd Wiz.State
expect "army":0,
cmd Wiz.State
expect "bones":1,
cmd Wiz.Summon
expect Wiz: summoned 0 skeletons (army 0, bones 1)
cmd Wiz.AddBones 4
expect Wiz: dropped 4 bones
wait 0.5
cmd Wiz.State
expect "army":0,
cmd Wiz.State
expect "bones":5,
cmd Wiz.State
expect "summon":2,
cmd Wiz.Tune SummonMax 1
expect Wiz: tuning SummonMax is 1
cmd Wiz.Summon
expect Wiz: summoned 1 skeletons (army 1, bones 3)
cmd Wiz.Tune SummonMax 0
expect Wiz: tuning SummonMax is 0
cmd Wiz.Summon
expect Wiz: summoned 1 skeletons (army 2, bones 1)
cmd Wiz.AddSkeletons 20
expect Wiz: added 20 of 20 skeletons
wait 8
cmd Wiz.State
expect "groups":4,
cmd Wiz.HealthBars 0
expect Wiz: health bars are off
cmd Wiz.HealthBars 1
expect Wiz: health bars are on
cmd Wiz.Tune GruntHealth 60
expect Wiz: tuning GruntHealth is 60
cmd Wiz.SpawnEnemies 30
expect Wiz: spawned 30 of 30 grunts
wait 8
shot bones
cmd Wiz.State
expect "bonesOnGround":
