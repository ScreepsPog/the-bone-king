# render 1280x720
cmd Wiz.Map Practice
expect Wiz: map is Practice
cmd Wiz.Waves 0
expect Wiz: waves are off
cmd Wiz.God 1
expect Wiz: god mode is on
wait 1
cmd Wiz.Keys
expect Blink=SpaceBar
cmd Wiz.State
expect "blink":"ready"
cmd Wiz.State
expect "heights":"150/170/175/240/286"
cmd Wiz.Blink 0 1
expect Wiz: blink along 0.0, 1.0
cmd Wiz.State
expect "hidden":true
cmd Wiz.Blink 0 1
expect Wiz: blink not cast (active
wait 1.0
cmd Wiz.State
expectnum 300 720 "y":
cmd Wiz.State
expect "blink":"cooldown"
cmd Wiz.State
expect "hidden":false
cmd Input.Press SpaceBar 0.1
wait 0.6
cmd Wiz.State
expect "blinks":1,
wait 3.0
cmd Wiz.State
expect "blink":"ready"
cmd Input.Press SpaceBar 0.1
wait 1.0
cmd Wiz.State
expect "blinks":2,
cmd Wiz.Tune GruntSize 0.5
expect Wiz: tuning GruntSize is 0.5
cmd Wiz.State
expect "heights":"150/110/175/240/286"
cmd Wiz.SpawnEnemies 3 Brute
expect Wiz: spawned 3 of 3 brutes
cmd Wiz.AddSkeletons 6
expect Wiz: added 6 of 6 skeletons
cmd Wiz.Commander
wait 0.5
shot sizes
