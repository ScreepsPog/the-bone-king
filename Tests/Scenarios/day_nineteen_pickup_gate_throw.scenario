# render 1280x720
# A pile of bones picked up, the gate opening and the commander's throw are each heard (direction of 2026-11-15 02:28 PST).
cmd Wiz.Waves 0
expect Wiz: waves are off
cmd Wiz.God 1
expect Wiz: god mode is on
cmd Wiz.Debug 0
cmd Wiz.Sound
expect "bonepickup":0
cmd Wiz.Sound
expect "gateopen":0
cmd Wiz.Tune GruntHealth 5
cmd Wiz.AddSkeletons 10
cmd Wiz.SpawnEnemies 3 Grunt 150 0
wait 6
cmd Wiz.Goto 150 0
wait 0.5
cmd Wiz.Sound
expectnum 1 9 "bonepickup":
cmd Wiz.Tune CommanderSpearWindup 1.2
cmd Wiz.SpawnEnemies 1 Commander 900 -300
wait 4
cmd Wiz.Sound
expectnum 1 9 "commanderspearthrow":
cmd Wiz.Sound
expectnum 1 9 "followed":
cmd Wiz.Sound
expectnum 3 9999 "followedMoves":
cmd Wiz.OpenGate
cmd Wiz.Sound
expect "gateopen":1
cmd Wiz.OpenGate
cmd Wiz.Sound
expect "gateopen":1
