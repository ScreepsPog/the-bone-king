# render 1280x720
cmd Wiz.Map Practice
expect Wiz: map is Practice
cmd Wiz.Waves 0
expect Wiz: waves are off
cmd Wiz.God 1
expect Wiz: god mode is on
wait 1
cmd Input.Press F 0.1
wait 0.4
cmd Wiz.State
expect "commandMode":false
cmd Wiz.AddSkeletons 8
expect Wiz: added 8 of 8 skeletons
cmd Wiz.Keys
expect Command=F
cmd Input.Press F 0.1
wait 0.4
cmd Wiz.State
expect "sent":0,"commandMode":true,"commandCount":4,"commandKind":"Any"
cmd Input.Wheel 2
wait 0.4
cmd Wiz.State
expect "commandCount":6
cmd Input.Press RightMouseButton 0.1
wait 0.4
cmd Wiz.State
expect "commandCount":6,"commandKind":"Skeleton"
cmd Input.Press RightMouseButton 0.1
wait 0.4
cmd Wiz.State
expect "commandCount":6,"commandKind":"Any"
shot command_mode
cmd Input.Press LeftMouseButton 0.1
wait 0.5
cmd Wiz.State
expect "sent":6,"commandMode":false
cmd Wiz.State
expect "armyValue":8,"boneWorth":8
cmd Wiz.State
expect "bolts":0,
cmd Input.Press C 0.1
wait 0.4
cmd Wiz.State
expect "sent":0,
cmd Wiz.Command 3 Any 900 0
expect Wiz: sent 3 to 900, 0 (3 sent in all, 5 with the wizard)
wait 3
shot command_sent
cmd Wiz.Recall
expect Wiz: recalled 3
