# render 1280x720
cmd Wiz.Map Practice
expect Wiz: map is Practice
cmd Wiz.Waves 0
expect Wiz: waves are off
cmd Wiz.God 1
expect Wiz: god mode is on
cmd Wiz.State
expect "walls":10,
cmd Wiz.Tune LeashRadius
expect Wiz: tuning LeashRadius is 500
cmd Wiz.Tune RoamRadius 300
expect Wiz: tuning RoamRadius is 300
cmd Wiz.Tune RoamRadius 350
expect Wiz: tuning RoamRadius is 350
cmd Wiz.Tune NoSuchValue
expect Wiz: no tuning value named
cmd Input.Press D 2.5
wait 3.0
cmd Wiz.State
expectnum 800 870 "y":
cmd Wiz.Obstacles 0
expect Wiz: obstacles are off (0 walls)
cmd Input.Press D 1.0
wait 1.5
cmd Wiz.State
expectnum 1300 1500 "y":
cmd Wiz.Obstacles 1
expect Wiz: obstacles are on (10 walls)
cmd Wiz.AddSkeletons 12
expect Wiz: added 12 of 12 skeletons
cmd Wiz.SpawnEnemies 40
expect Wiz: spawned 40 of 40 grunts
wait 6
shot walls
cmd Wiz.State
expect Wiz: {"army":
